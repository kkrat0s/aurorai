# The local public-data UI and scripted policy demo need no credentials.
# Copy to apps/web/.env.local only when integrating an authorized test project.
# Never prefix a secret with NEXT_PUBLIC_. Never paste secrets into logs or chat.
META_MODEL_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Actual Meta transport requires a durable budget/journal and verified researcher auth.
# No deployed model route or participant upload is enabled by this template.
